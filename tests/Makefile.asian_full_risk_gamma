CC ?= gcc
CXX ?= g++
CFLAGS := -std=c11 -O3 -march=skylake-avx512 -mavx512bw -mfma \
	-fno-tree-vectorize -ffp-contract=off -fno-fast-math \
	-ffunction-sections -fdata-sections -Wall -Wextra -Werror -I.
CXXFLAGS := -std=c++17 -O2 -Wall -Wextra -Werror -I. \
	$(shell quantlib-config --cflags 2>/dev/null)
LDFLAGS := -Wl,--gc-sections -lm
QLLDFLAGS := $(shell quantlib-config --libs 2>/dev/null)
OBJDIR := .asian_full_risk_gamma_objects
TEST := test_asian_full_risk_gamma
BENCH := bench_asian_full_risk_gamma
QL := asian_full_risk_gamma_quantlib

COMMON_SOURCES := \
	asian_arithmetic_joe_kuo_256.s \
	asian_genuine_permute_setup.c \
	asian_genuine_multistrike_full_risk_setup.c \
	asian_genuine_multistrike_full_risk_avx512.s \
	asian_genuine_fixed_block_source_setup.c \
	asian_genuine_fixed_block_source_avx512.s \
	asian_geometric_cv_payoff_avx512.s \
	asian_genuine_price_delta_strip_setup.c \
	asian_genuine_price_delta_strip_avx512.s \
	asian_genuine_arithmetic_growth_only_setup.c \
	asian_genuine_arithmetic_growth_only_strip_adapter.c \
	asian_genuine_arithmetic_growth_only_q_avx512.s \
	asian_genuine_arithmetic_fused_source_exp_setup.c \
	asian_genuine_arithmetic_fused_source_exp_avx512.s \
	private/asian_meta_direction_descriptors.c \
	private/asian_meta_direction_affine_route.c \
	private/asian_meta_direction_qsort_control.c \
	private/asian_meta_arithmetic_growth_only_q_avx512.s \
	asian_geometric_cv_packet_local_setup.c \
	asian_geometric_cv_packet_local_avx512.s \
	asian_geometric_cv_immediate_setup.c \
	asian_geometric_cv_immediate_avx512.s \
	private/asian_affine_route_family_generic_immediate_avx512.S \
	private/asian_affine_route_family_generic_packet_avx512.s \
	asian_affine_route_family.c \
	asian_genuine_aad_phase1_setup.c \
	asian_genuine_aad_phase1_avx512.s \
	private/asian_commercial_full_risk_affine_phase1_avx512.S \
	asian_affine_family_full_risk_k1.c \
	asian_commercial_full_risk_lifecycle.c \
	asian_full_risk_gamma.c \
	private/asian_full_risk_gamma_affine_phase1_avx512.S

COMMON_OBJECTS := $(addprefix $(OBJDIR)/,$(COMMON_SOURCES))
COMMON_OBJECTS := $(COMMON_OBJECTS:.c=.o)
COMMON_OBJECTS := $(COMMON_OBJECTS:.s=.o)
COMMON_OBJECTS := $(COMMON_OBJECTS:.S=.o)
TEST_OBJECTS := $(OBJDIR)/tests/test_asian_full_risk_gamma.o \
	$(OBJDIR)/tests/asian_full_risk_gamma_leaf_wrap.o
BENCH_OBJECT := $(OBJDIR)/benchmarks/bench_asian_full_risk_gamma.o
QL_OBJECT := $(OBJDIR)/tests/asian_full_risk_gamma_quantlib.o

WRAPS := \
	-Wl,--wrap=asian_full_risk_gamma_affine_call_impl_diag \
	-Wl,--wrap=asian_full_risk_gamma_affine_put_impl_diag

.DELETE_ON_ERROR:
.PHONY: check audit benchmark-native clean

$(OBJDIR)/%.o: %.c
	@mkdir -p $(@D)
	@$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.s private/asian_genuine_fixed_block_signed_z.bin \
		direction_numbers/joe_kuo_6_21201.bin
	@mkdir -p $(@D)
	@$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.S private/asian_genuine_fixed_block_signed_z.bin \
		direction_numbers/joe_kuo_6_21201.bin \
		asian_genuine_aad_phase1_avx512.s
	@mkdir -p $(@D)
	@$(CC) $(CFLAGS) -c $< -o $@

$(QL_OBJECT): tests/asian_full_risk_gamma_quantlib.cpp
	@mkdir -p $(@D)
	@$(CXX) $(CXXFLAGS) -c $< -o $@

$(TEST): $(TEST_OBJECTS) $(COMMON_OBJECTS)
	@$(CC) $(CFLAGS) $^ $(WRAPS) $(LDFLAGS) -o $@

$(BENCH): $(BENCH_OBJECT) $(COMMON_OBJECTS)
	@$(CC) $(CFLAGS) $^ $(LDFLAGS) -o $@

$(QL): $(QL_OBJECT)
	@$(CXX) $(CXXFLAGS) $^ $(QLLDFLAGS) -o $@

check: $(TEST) $(BENCH) $(QL)
	@command -v quantlib-config >/dev/null
	@test "$$(quantlib-config --version)" = "1.39-dev"
	@ldd ./$(QL) | grep -q 'libQuantLib\.so'
	@/opt/intel-sde/sde64 -spr -- ./$(BENCH) --check
	@python3 tests/compare_asian_full_risk_gamma.py \
		--test ./$(TEST) --quantlib ./$(QL)

audit: $(BENCH)
	@python3 tests/audit_asian_full_risk_gamma.py --binary ./$(BENCH)

benchmark-native: $(TEST) $(BENCH)
	@test "$(CPU)" = "0" || \
		(echo "CPU=0 on Sapphire Rapids is required" >&2; exit 2)
	@./$(TEST)
	@./$(BENCH) --native-check --cpu $(CPU)
	@python3 tests/audit_asian_full_risk_gamma.py --binary ./$(BENCH)
	@./$(BENCH) --timing --cpu $(CPU)

clean:
	@$(RM) -r $(OBJDIR) $(TEST) $(BENCH) $(QL)
