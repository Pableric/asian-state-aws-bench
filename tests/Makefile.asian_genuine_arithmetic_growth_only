CC ?= gcc
CFLAGS := -std=c11 -O3 -march=skylake-avx512 -mavx512bw -mfma \
	-fno-tree-vectorize -ffp-contract=off -fno-fast-math \
	-ffunction-sections -fdata-sections -Wall -Wextra -Werror -I.
LDFLAGS := -Wl,--gc-sections -lm
OBJDIR := .asian_genuine_arithmetic_growth_only_objects

COMMON_SOURCES := \
	asian_genuine_permute_setup.c \
	asian_genuine_multistrike_full_risk_setup.c \
	asian_genuine_fixed_block_source_setup.c \
	asian_genuine_fixed_block_source_avx512.s \
	asian_geometric_cv_payoff_avx512.s \
	asian_genuine_price_delta_strip_setup.c \
	asian_genuine_price_delta_strip_avx512.s \
	asian_genuine_arithmetic_growth_only_setup.c \
	asian_genuine_arithmetic_growth_only_sha256.c \
	asian_genuine_arithmetic_growth_only_strip_adapter.c \
	asian_genuine_arithmetic_downstream_layout_anchor.s \
	asian_genuine_arithmetic_growth_only_q_avx512.s \
	asian_genuine_arithmetic_fused_source_exp_setup.c \
	asian_genuine_arithmetic_fused_source_exp_avx512.s

COMMON_OBJECTS := $(addprefix $(OBJDIR)/,$(COMMON_SOURCES))
COMMON_OBJECTS := $(COMMON_OBJECTS:.c=.o)
COMMON_OBJECTS := $(COMMON_OBJECTS:.s=.o)
TEST_EXTRAS := \
	$(OBJDIR)/asian_genuine_sql_variable_avx512.o
TEST_OBJECT := $(OBJDIR)/tests/test_asian_genuine_arithmetic_growth_only.o
BENCH_OBJECT := $(OBJDIR)/benchmarks/bench_asian_genuine_arithmetic_growth_only.o

.PHONY: check audit benchmark-native clean

$(OBJDIR)/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.s private/asian_genuine_fixed_block_signed_z.bin
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -c $< -o $@

test_asian_genuine_arithmetic_growth_only: $(TEST_OBJECT) $(COMMON_OBJECTS) $(TEST_EXTRAS)
	$(CC) $(CFLAGS) $^ $(LDFLAGS) -o $@

bench_asian_genuine_arithmetic_growth_only: $(BENCH_OBJECT) $(COMMON_OBJECTS)
	$(CC) $(CFLAGS) $^ $(LDFLAGS) -o $@

check: test_asian_genuine_arithmetic_growth_only bench_asian_genuine_arithmetic_growth_only
	/opt/intel-sde/sde64 -skx -- ./test_asian_genuine_arithmetic_growth_only
	python3 tests/audit_asian_genuine_arithmetic_growth_only.py \
		--binary ./bench_asian_genuine_arithmetic_growth_only

audit: bench_asian_genuine_arithmetic_growth_only
	python3 tests/audit_asian_genuine_arithmetic_growth_only.py \
		--binary ./bench_asian_genuine_arithmetic_growth_only

benchmark-native: bench_asian_genuine_arithmetic_growth_only
	@test -n "$(CPU)" || (echo "CPU=<permitted Sapphire Rapids logical CPU> is required"; exit 2)
	./bench_asian_genuine_arithmetic_growth_only --cpu $(CPU) \
		--check-only
	python3 tests/audit_asian_genuine_arithmetic_growth_only.py \
		--binary ./bench_asian_genuine_arithmetic_growth_only
	@case "$(MODE)" in \
	  ""|full) mode=full ;; \
	  crossover) mode=crossover ;; \
	  confirm) mode=confirm ;; \
	  *) echo "MODE must be full, crossover, or confirm" >&2; exit 2 ;; \
	esac; \
	./bench_asian_genuine_arithmetic_growth_only --cpu $(CPU) --mode=$$mode

clean:
	$(RM) -r $(OBJDIR) test_asian_genuine_arithmetic_growth_only \
		bench_asian_genuine_arithmetic_growth_only
