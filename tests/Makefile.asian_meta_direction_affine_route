CC ?= gcc
CFLAGS := -std=c11 -O3 -march=skylake-avx512 -mavx512bw -mfma \
	-fno-tree-vectorize -ffp-contract=off -fno-fast-math \
	-ffunction-sections -fdata-sections -Wall -Wextra -Werror -I.
LDFLAGS := -Wl,--gc-sections -lm
OBJDIR := .asian_meta_direction_affine_route_objects
TEST := test_asian_meta_direction_affine_route
BENCH := bench_asian_meta_direction_affine_route

SOURCES := \
	asian_arithmetic_pricer.c \
	asian_arithmetic_joe_kuo_256.s \
	asian_genuine_permute_setup.c \
	asian_genuine_multistrike_full_risk_setup.c \
	asian_genuine_fixed_block_source_setup.c \
	asian_genuine_fixed_block_source_avx512.s \
	asian_geometric_cv_payoff_avx512.s \
	asian_genuine_price_delta_strip_setup.c \
	asian_genuine_price_delta_strip_avx512.s \
	asian_genuine_arithmetic_growth_only_setup.c \
	asian_genuine_arithmetic_growth_only_sha256.c \
	asian_genuine_arithmetic_growth_only_strip_adapter.c \
	asian_genuine_arithmetic_downstream_layout_anchor.s \
	asian_genuine_arithmetic_growth_only_q_avx512.s \
	asian_genuine_arithmetic_fused_source_exp_setup.c \
	asian_genuine_arithmetic_fused_source_exp_avx512.s \
	asian_genuine_sql_variable_avx512.s \
	private/asian_meta_direction_descriptors.c \
	private/asian_meta_direction_affine_route.c \
	private/asian_meta_direction_qsort_control.c \
	private/asian_meta_arithmetic_growth_only_q_avx512.s \
	private/asian_meta_affine_dual_provider_avx512.s \
	private/asian_meta_affine_sql_dual_control_avx512.s

OBJECTS := $(addprefix $(OBJDIR)/,$(SOURCES))
OBJECTS := $(OBJECTS:.c=.o)
OBJECTS := $(OBJECTS:.s=.o)
TEST_OBJECT := $(OBJDIR)/tests/test_asian_meta_direction_affine_route.o
BENCH_OBJECT := $(OBJDIR)/benchmarks/bench_asian_meta_direction_affine_route.o

AUDIT := python3 tests/audit_asian_meta_direction_affine_route.py \
	--binary ./$(BENCH) --test-binary ./$(TEST) \
	--fused-object $(OBJDIR)/asian_genuine_arithmetic_fused_source_exp_avx512.o \
	--growth-object $(OBJDIR)/asian_genuine_arithmetic_growth_only_q_avx512.o \
	--strip-object $(OBJDIR)/asian_genuine_price_delta_strip_avx512.o

.DELETE_ON_ERROR:
.PHONY: check audit benchmark-native

$(OBJDIR)/%.o: %.c
	@mkdir -p $(@D)
	@$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.s private/asian_genuine_fixed_block_signed_z.bin \
		direction_numbers/joe_kuo_6_21201.bin
	@mkdir -p $(@D)
	@$(CC) $(CFLAGS) -c $< -o $@

$(TEST): $(TEST_OBJECT) $(OBJECTS)
	@$(CC) $(CFLAGS) $^ $(LDFLAGS) -o $@

$(BENCH): $(BENCH_OBJECT) $(OBJECTS)
	@$(CC) $(CFLAGS) $^ $(LDFLAGS) -o $@

check: $(TEST) $(BENCH)
	@/opt/intel-sde/sde64 -spr -- ./$(TEST)
	@/opt/intel-sde/sde64 -spr -- ./$(BENCH) --check

audit: $(TEST) $(BENCH)
	@$(AUDIT)

benchmark-native: $(TEST) $(BENCH)
	@test "$(CPU)" = "0" || \
	  (echo "CPU=0 on Sapphire Rapids is required" >&2; exit 2)
	@./$(BENCH) --native-check --cpu $(CPU) >/dev/null
	@$(AUDIT) >/dev/null
	@./$(BENCH) --timing --cpu $(CPU)
