CC ?= gcc
CXX ?= g++
CFLAGS := -std=c11 -O3 -march=skylake-avx512 -mavx512bw -mfma \
	-fno-tree-vectorize -ffp-contract=off -fno-fast-math \
	-ffunction-sections -fdata-sections -Wall -Wextra -Werror -I.
CXXFLAGS := -std=c++17 -O2 -ffunction-sections -fdata-sections \
	-Wall -Wextra -Werror -I.
LDFLAGS := -Wl,--gc-sections -lm
OBJDIR := .autocall_single_asset_three_date_raw_objects
TEST := test_autocall_single_asset_three_date_raw
REFERENCE := reference_autocall_single_asset_three_date_raw
BENCH := bench_autocall_single_asset_three_date_raw

NORMAL_SOURCES := \
	asian_genuine_fixed_block_source_avx512.s \
	asian_genuine_arithmetic_fused_source_exp_avx512.s \
	private/asian_meta_direction_descriptors.c \
	private/asian_meta_direction_affine_route.c \
	private/autocall_single_asset_three_date_raw_avx512.S \
	autocall_single_asset_three_date_raw.c
NORMAL_OBJECTS := $(addprefix $(OBJDIR)/,$(NORMAL_SOURCES))
NORMAL_OBJECTS := $(NORMAL_OBJECTS:.c=.o)
NORMAL_OBJECTS := $(NORMAL_OBJECTS:.s=.o)
NORMAL_OBJECTS := $(NORMAL_OBJECTS:.S=.o)
TEST_EXTRA := \
	$(OBJDIR)/asian_arithmetic_joe_kuo_256.o \
	$(OBJDIR)/asian_genuine_permute_setup.o \
	$(OBJDIR)/private/asian_meta_direction_qsort_control.o \
	$(OBJDIR)/tests/autocall_single_asset_three_date_generic_avx512.o \
	$(OBJDIR)/tests/autocall_single_asset_three_date_leaf_wrap.o \
	$(OBJDIR)/tests/test_autocall_single_asset_three_date_raw.o
BENCH_OBJECT := $(OBJDIR)/benchmarks/bench_autocall_single_asset_three_date_raw.o
BENCH_DIAG_OBJECTS := \
	$(OBJDIR)/asian_arithmetic_joe_kuo_256.o \
	$(OBJDIR)/asian_genuine_permute_setup.o \
	$(OBJDIR)/private/asian_meta_direction_qsort_control.o \
	$(OBJDIR)/tests/autocall_single_asset_three_date_generic_avx512.o
REFERENCE_OBJECTS := \
	$(OBJDIR)/tests/reference_autocall_single_asset_three_date_raw.o \
	$(OBJDIR)/asian_arithmetic_joe_kuo_256.o

.DELETE_ON_ERROR:
.PHONY: check audit benchmark-native dedicated-check clean

$(OBJDIR)/%.o: %.c
	@mkdir -p $(@D)
	@$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(@D)
	@$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.s private/asian_genuine_fixed_block_signed_z.bin \
		direction_numbers/joe_kuo_6_21201.bin
	@mkdir -p $(@D)
	@$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.S private/asian_genuine_fixed_block_signed_z.bin \
		direction_numbers/joe_kuo_6_21201.bin
	@mkdir -p $(@D)
	@$(CC) $(CFLAGS) -c $< -o $@

$(TEST): $(NORMAL_OBJECTS) $(TEST_EXTRA)
	@$(CC) $(CFLAGS) $^ -Wl,--wrap=autocall_3date_affine_price_leaf \
		$(LDFLAGS) -o $@

$(REFERENCE): $(REFERENCE_OBJECTS)
	@$(CXX) $(CXXFLAGS) $^ $(LDFLAGS) -o $@

$(BENCH): $(NORMAL_OBJECTS) $(BENCH_OBJECT) $(BENCH_DIAG_OBJECTS)
	@$(CC) $(CFLAGS) $^ $(LDFLAGS) -o $@

dedicated-check: $(TEST) $(REFERENCE) $(BENCH)
	@python3 tests/compare_autocall_single_asset_three_date_raw.py
	@/opt/intel-sde/sde64 -spr -- ./$(BENCH) --check

check: dedicated-check
	@$(MAKE) -f tests/Makefile.asian_meta_direction_affine_route check
	@$(MAKE) test-ordered-d1-sde

audit: $(BENCH)
	@python3 tests/audit_autocall_single_asset_three_date_raw.py \
		--binary ./$(BENCH)

benchmark-native: $(TEST) $(REFERENCE) $(BENCH)
	@test "$(CPU)" = "0" || \
		(echo "CPU=0 on Sapphire Rapids is required" >&2; exit 2)
	@./$(BENCH) --native-check --cpu $(CPU) >/dev/null
	@./$(TEST) >/dev/null
	@./$(REFERENCE) >/dev/null
	@python3 tests/audit_autocall_single_asset_three_date_raw.py \
		--binary ./$(BENCH)
	@./$(BENCH) --timing --cpu $(CPU)

clean:
	@rm -rf $(OBJDIR) $(TEST) $(REFERENCE) $(BENCH)
